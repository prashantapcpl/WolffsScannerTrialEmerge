"""
dashboard.py â€” Multi-Scanner Dashboard
Fixed: ##key not showing in labels, reduced flashing, gap-fill badge shown.
"""

import streamlit as st
import json
import os
import sys
import time
import socket
import pandas as pd
from datetime import datetime
import pytz

ROOT = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, ROOT)

from core.price_store import load_live_prices


def _get_server_ip() -> str:
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except Exception:
        return "YOUR_SERVER_IP"

IST = pytz.timezone("Asia/Kolkata")

st.set_page_config(
    page_title="Fyers RSI Scanner",
    page_icon="ðŸ“ˆ",
    layout="wide",
    initial_sidebar_state="expanded"
)

CONFIG_PATH = os.path.join(ROOT, "config.json")
TOKEN_PATH  = os.path.join(ROOT, "data", "access_token.json")
RESCAN_FLAG = os.path.join(ROOT, "data", "rescan.flag")


def load_config():
    with open(CONFIG_PATH, "r") as f:
        return json.load(f)

def save_config(config):
    with open(CONFIG_PATH, "w") as f:
        json.dump(config, f, indent=2)

def load_scanner_state(scanner_id):
    config     = load_config()
    state_file = config.get("scanners", {}).get(scanner_id, {}).get(
        "state_file", f"data/{scanner_id}_state.json")
    state_path = os.path.join(ROOT, state_file)
    if not os.path.exists(state_path):
        return {"records": {}, "signal_log": []}
    with open(state_path, "r") as f:
        return json.load(f)

def fmt_dt(s):
    if not s:
        return "-"
    return str(s)[:16].replace("T", " ")

def get_token_status():
    if not os.path.exists(TOKEN_PATH):
        return "âŒ Not logged in"
    with open(TOKEN_PATH, "r") as f:
        data = json.load(f)
    today = str(datetime.now(IST).date())
    return (f"âœ… Logged in ({today})"
            if data.get("saved_date") == today
            else f"âš ï¸  Token expired")

def colored_pnl(pnl):
    return f"ðŸŸ¢ +{pnl:.2f}%" if pnl >= 0 else f"ðŸ”´ {pnl:.2f}%"

# Module-level live_prices dict; updated inside _render_data on every refresh
live_prices = {}

def live_price(sym: str, fallback) -> float:
    """Return live tick price if available, else fall back to state's current_price."""
    p = live_prices.get(sym)
    return float(p) if p else (float(fallback) if fallback else 0.0)

def trigger_rescan(scanner_id):
    os.makedirs(os.path.dirname(RESCAN_FLAG), exist_ok=True)
    with open(RESCAN_FLAG, "w") as f:
        f.write(f"{scanner_id}:{datetime.now(IST).isoformat()}")

# â”€â”€â”€ Sidebar â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
with st.sidebar:
    st.title("ðŸ“ˆ RSI Scanner")
    st.caption(f"ðŸ• {datetime.now(IST).strftime('%d %b %Y  %H:%M:%S')}")
    st.markdown("---")
    st.markdown(get_token_status())
    st.markdown("---")
    # key= preserves nav selection across auto-reruns â€” prevents Active Buys flash
    st.radio("", [
        "ðŸŸ¢ Active Buys",
        "ðŸ”´ Exit Signals",
        "ðŸ‘ï¸ Watched Stocks",
        "ðŸ“‹ Signal Log",
        "âš™ï¸ Settings"
    ], label_visibility="collapsed", key="nav_select")
    st.markdown("---")
    if st.button("ðŸ”„ Refresh", use_container_width=True):
        st.rerun()
    st.checkbox("Auto-refresh (15s)", value=True, key="auto_refresh_cb")

# â”€â”€â”€ Header â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
st.title("ðŸ“ˆ Fyers RSI Scanner")

# â”€â”€â”€ Scanner 3 tab renderer â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
def _render_s3_tab(scanner_id: str, scfg: dict, config: dict, nav: str):
    """Renders the complete Scanner 3 (Webhook Mirror) tab."""

    state      = load_scanner_state(scanner_id)
    records    = state.get("records", {})
    signal_log = state.get("signal_log", [])

    # Segregate positions by side
    buy_side  = {s: r for s, r in records.items()
                 if r.get("side") == "BUY"  and r.get("state") != "GENERAL"}
    sell_side = {s: r for s, r in records.items()
                 if r.get("side") == "SELL" and r.get("state") != "GENERAL"}
    watched   = {s: r for s, r in records.items()
                 if r.get("state") in ("WATCHED_BUY", "WATCHED_SELL")}
    active    = {s: r for s, r in records.items()
                 if r.get("state") in ("ACTIVE_BUY", "ACTIVE_SELL",
                                       "EXITING_BUY", "EXITING_SELL")}
    exits     = [e for e in reversed(signal_log)
                 if e.get("type") in ("EXIT_BUY", "EXIT_SELL")]

    m1, m2, m3, m4 = st.columns(4)
    m1.metric("ðŸŸ¢ Long Positions",  len(buy_side))
    m2.metric("ðŸ”´ Short Positions", len(sell_side))
    m3.metric("ðŸ‘ï¸ Watching",        len(watched))
    m4.metric("ðŸ“‹ Exits Today",     len(exits))
    st.markdown("---")

    cfg = scfg.get("settings", {})

    # â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    # ACTIVE POSITIONS
    # â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    if nav == "ðŸŸ¢ Active Buys":
        # BUY side
        st.subheader(f"ðŸŸ¢ Long Positions (BUY side) â€” {len(buy_side)} stocks")
        if not buy_side:
            st.info("No active long positions.")
        else:
            rows = []
            for sym, r in sorted(buy_side.items(),
                                  key=lambda x: x[1].get("entry_time") or "", reverse=True):
                ref    = r.get("ref_price") or 0
                entry  = r.get("entry_price") or 0
                cur    = live_price(sym, r.get("current_price") or entry)
                pnl    = round(((cur - entry) / entry * 100), 2) if entry else 0
                state_ = r.get("state","")
                status = ("EXITING" if "EXITING" in state_
                          else f"Avg {r.get('avg_count',0)}" if r.get("avg_count",0) > 0
                          else "ACTIVE")
                rows.append({
                    "Stock":      r.get("plain_name", sym),
                    "Status":     status,
                    "Ref â‚¹":      f"â‚¹{ref:.2f}",
                    "Ref Time":   fmt_dt(r.get("ref_time")),
                    "Entry â‚¹":    f"â‚¹{entry:.2f}",
                    "Entry Time": fmt_dt(r.get("entry_time")),
                    "Now â‚¹":      f"â‚¹{cur:.2f}",
                    "Avgs":       r.get("avg_count", 0),
                    "P&L":        colored_pnl(pnl),
                })
            st.dataframe(pd.DataFrame(rows), use_container_width=True, hide_index=True)

            st.markdown("### Full Detail (Long)")
            for sym, r in sorted(buy_side.items(),
                                  key=lambda x: x[1].get("entry_time") or "", reverse=True):
                ref    = r.get("ref_price") or 0
                entry  = r.get("entry_price") or 0
                cur    = live_price(sym, r.get("current_price") or entry)
                pnl    = round(((cur - entry) / entry * 100), 2) if entry else 0
                state_ = r.get("state","")
                status = "EXITING" if "EXITING" in state_ else f"Avg {r.get('avg_count',0)}" if r.get("avg_count",0) > 0 else "ACTIVE"
                st.markdown(f"### ðŸŸ¢ **{r.get('plain_name',sym)}** &nbsp; `{status}` &nbsp; {colored_pnl(pnl)}")
                st.caption(r.get("company_name",""))
                c1, c2, c3, c4 = st.columns(4)
                c1.metric("Ref Price",   f"â‚¹{ref:.2f}",   fmt_dt(r.get("ref_time")))
                c2.metric("Entry Price", f"â‚¹{entry:.2f}", fmt_dt(r.get("entry_time")))
                c3.metric("Now",         f"â‚¹{cur:.2f}")
                c4.metric("P&L",         f"{pnl:+.2f}%")
                if r.get("state") in ("EXITING_BUY",):
                    st.caption(f"Exit ref: â‚¹{r.get('exit_ref_price',0):.2f} "
                               f"@ {fmt_dt(r.get('exit_ref_time'))} â€” "
                               f"waiting {cfg.get('exit_offset_pct_buy',1.0):.1f}% above")
                if r.get("avg_entries"):
                    avg_rows = [{"Level": f"Avg {a.get('avg_num','')}", "Price": f"â‚¹{a.get('price',0):.2f}",
                                 "Time": fmt_dt(a.get("signal_time")), "Move %": f"{a.get('change_pct',0):.2f}%"}
                                for a in r.get("avg_entries", [])]
                    st.dataframe(pd.DataFrame(avg_rows), use_container_width=False, hide_index=True)
                st.divider()

        st.markdown("---")

        # SELL side
        st.subheader(f"ðŸ”´ Short Positions (SELL side) â€” {len(sell_side)} stocks")
        if not sell_side:
            st.info("No active short positions.")
        else:
            rows = []
            for sym, r in sorted(sell_side.items(),
                                  key=lambda x: x[1].get("entry_time") or "", reverse=True):
                ref    = r.get("ref_price") or 0
                entry  = r.get("entry_price") or 0
                cur    = live_price(sym, r.get("current_price") or entry)
                pnl    = round(((entry - cur) / entry * 100), 2) if entry else 0
                state_ = r.get("state","")
                status = ("EXITING" if "EXITING" in state_
                          else f"Avg Short {r.get('avg_count',0)}" if r.get("avg_count",0) > 0
                          else "ACTIVE")
                rows.append({
                    "Stock":      r.get("plain_name", sym),
                    "Status":     status,
                    "Ref â‚¹":      f"â‚¹{ref:.2f}",
                    "Ref Time":   fmt_dt(r.get("ref_time")),
                    "Entry â‚¹":    f"â‚¹{entry:.2f}",
                    "Entry Time": fmt_dt(r.get("entry_time")),
                    "Now â‚¹":      f"â‚¹{cur:.2f}",
                    "Avgs":       r.get("avg_count", 0),
                    "P&L":        colored_pnl(pnl),
                })
            st.dataframe(pd.DataFrame(rows), use_container_width=True, hide_index=True)

            st.markdown("### Full Detail (Short)")
            for sym, r in sorted(sell_side.items(),
                                  key=lambda x: x[1].get("entry_time") or "", reverse=True):
                ref    = r.get("ref_price") or 0
                entry  = r.get("entry_price") or 0
                cur    = live_price(sym, r.get("current_price") or entry)
                pnl    = round(((entry - cur) / entry * 100), 2) if entry else 0
                state_ = r.get("state","")
                status = "EXITING" if "EXITING" in state_ else f"Avg Short {r.get('avg_count',0)}" if r.get("avg_count",0) > 0 else "ACTIVE"
                st.markdown(f"### ðŸ”´ **{r.get('plain_name',sym)}** &nbsp; `{status}` &nbsp; {colored_pnl(pnl)}")
                st.caption(r.get("company_name",""))
                c1, c2, c3, c4 = st.columns(4)
                c1.metric("Ref Price",   f"â‚¹{ref:.2f}",   fmt_dt(r.get("ref_time")))
                c2.metric("Entry Price", f"â‚¹{entry:.2f}", fmt_dt(r.get("entry_time")))
                c3.metric("Now",         f"â‚¹{cur:.2f}")
                c4.metric("P&L",         f"{pnl:+.2f}%")
                if r.get("state") in ("EXITING_SELL",):
                    st.caption(f"Exit ref: â‚¹{r.get('exit_ref_price',0):.2f} "
                               f"@ {fmt_dt(r.get('exit_ref_time'))} â€” "
                               f"waiting {cfg.get('exit_offset_pct_sell',1.0):.1f}% below")
                if r.get("avg_entries"):
                    avg_rows = [{"Level": f"Avg Short {a.get('avg_num','')}", "Price": f"â‚¹{a.get('price',0):.2f}",
                                 "Time": fmt_dt(a.get("signal_time")), "Move %": f"{a.get('change_pct',0):.2f}%"}
                                for a in r.get("avg_entries", [])]
                    st.dataframe(pd.DataFrame(avg_rows), use_container_width=False, hide_index=True)
                st.divider()

    # â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    # EXIT SIGNALS
    # â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    elif nav == "ðŸ”´ Exit Signals":
        st.subheader(f"ðŸ”´ Closed Positions â€” {len(exits)} total")
        if not exits:
            st.info("No exit signals yet.")
        else:
            rows = []
            for e in exits[:200]:
                entry_p = e.get("entry_price") or 0
                exit_p  = e.get("price") or 0
                pnl     = e.get("pnl_pct", 0)
                side    = "LONG" if e.get("type") == "EXIT_BUY" else "SHORT"
                rows.append({
                    "Stock":      e.get("plain_name",""),
                    "Side":       side,
                    "Entry â‚¹":    f"â‚¹{entry_p:.2f}",
                    "Exit â‚¹":     f"â‚¹{exit_p:.2f}",
                    "Exit Time":  fmt_dt(e.get("time")),
                    "Avgs":       e.get("avg_count", 0),
                    "P&L":        colored_pnl(float(pnl) if pnl else 0),
                })
            st.dataframe(pd.DataFrame(rows), use_container_width=True, hide_index=True)

    # â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    # WATCHED
    # â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    elif nav == "ðŸ‘ï¸ Watched Stocks":
        st.subheader(f"ðŸ‘ï¸ Waiting for Entry â€” {len(watched)} stocks")
        if not watched:
            st.info("No stocks waiting for entry trigger.")
        else:
            rows = []
            for sym, r in sorted(watched.items(),
                                  key=lambda x: x[1].get("ref_time") or "", reverse=True):
                ref  = r.get("ref_price") or 0
                cur  = live_price(sym, r.get("current_price") or ref)
                side = r.get("side","")
                if side == "BUY":
                    dist = round(((ref - cur) / ref * 100), 2) if ref else 0
                    need = max(0, round(float(cfg.get("drop_pct", 2.0)) - dist, 2))
                    trigger_note = f"Need {need:.2f}% more drop"
                else:
                    dist = round(((cur - ref) / ref * 100), 2) if ref else 0
                    need = max(0, round(float(cfg.get("rise_pct", 2.0)) - dist, 2))
                    trigger_note = f"Need {need:.2f}% more rise"
                rows.append({
                    "Side":     side,
                    "Stock":    r.get("plain_name", sym),
                    "Ref â‚¹":    f"â‚¹{ref:.2f}",
                    "Ref Time": fmt_dt(r.get("ref_time")),
                    "Now â‚¹":    f"â‚¹{cur:.2f}",
                    "Distance": f"{dist:.2f}%",
                    "Trigger":  trigger_note,
                })
            st.dataframe(pd.DataFrame(rows), use_container_width=True, hide_index=True)

    # â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    # SIGNAL LOG
    # â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    elif nav == "ðŸ“‹ Signal Log":
        st.subheader("ðŸ“‹ Signal Log â€” Scanner 3")
        if not signal_log:
            st.info("No signals yet.")
        else:
            rows = []
            for e in reversed(signal_log):
                t  = e.get("type","")
                px = e.get("price") or e.get("avg_price") or 0
                rows.append({
                    "Type":  e.get("label", t),
                    "Stock": e.get("plain_name",""),
                    "Price": f"â‚¹{float(px):.2f}" if px else "-",
                    "Time":  fmt_dt(e.get("time")),
                    "Info":  (
                        f"Ref:â‚¹{e.get('ref_price',0):.2f}"
                        if t in ("BUY","SELL") else
                        f"Entry:â‚¹{e.get('entry_price',0):.2f} P&L:{e.get('pnl_pct',0):+.2f}%"
                        if "EXIT" in t else
                        f"Avg #{e.get('avg_number','')} prev:â‚¹{e.get('avg_price',0):.2f}"
                    ),
                })
            st.dataframe(pd.DataFrame(rows), use_container_width=True, hide_index=True)

    # â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    # SETTINGS
    # â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    elif nav == "âš™ï¸ Settings":
        st.subheader("âš™ï¸ Settings â€” Scanner 3 (Webhook Mirror)")

        server_ip = _get_server_ip()
        port      = scfg.get("incoming_webhooks", {}).get("server_port", 5001)

        # â”€â”€ Incoming webhook URLs (read-only) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        st.markdown("#### ðŸ“¥ Incoming Webhook URLs")
        st.info("Copy these URLs and paste into your Chartink alert settings.")
        col_a, col_b = st.columns(2)
        with col_a:
            st.text_input("BUY alerts URL",
                value=f"http://{server_ip}:{port}/s3/buy",
                disabled=True, key="s3_url_buy")
            st.text_input("EXIT-BUY URL",
                value=f"http://{server_ip}:{port}/s3/exit-buy",
                disabled=True, key="s3_url_exit_buy")
        with col_b:
            st.text_input("SELL alerts URL",
                value=f"http://{server_ip}:{port}/s3/sell",
                disabled=True, key="s3_url_sell")
            st.text_input("EXIT-SELL URL",
                value=f"http://{server_ip}:{port}/s3/exit-sell",
                disabled=True, key="s3_url_exit_sell")
        st.caption(f"Server IP: **{server_ip}** | Port: **{port}** "
                   f"| Status check: http://{server_ip}:{port}/s3/status")

        st.markdown("---")

        # â”€â”€ Outgoing webhook URLs (editable) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        st.markdown("#### ðŸ“¤ Outgoing Webhook URLs")
        st.caption("Where to send signals when entry/exit conditions are met.")
        ow = scfg.get("outgoing_webhooks", {})
        col_c, col_d = st.columns(2)
        with col_c:
            buy_url      = st.text_input("ðŸŸ¢ BUY signal URL",
                value=ow.get("buy_url",""),
                placeholder="https://your-app.com/webhook/buy",
                key="s3_out_buy")
            exit_buy_url = st.text_input("ðŸ”´ EXIT-BUY URL",
                value=ow.get("exit_buy_url",""),
                placeholder="https://your-app.com/webhook/exit-buy",
                key="s3_out_exit_buy")
        with col_d:
            sell_url      = st.text_input("ðŸ”´ SELL signal URL",
                value=ow.get("sell_url",""),
                placeholder="https://your-app.com/webhook/sell",
                key="s3_out_sell")
            exit_sell_url = st.text_input("ðŸŸ¢ EXIT-SELL URL",
                value=ow.get("exit_sell_url",""),
                placeholder="https://your-app.com/webhook/exit-sell",
                key="s3_out_exit_sell")

        st.markdown("---")

        # â”€â”€ Strategy parameters â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        st.markdown("#### âš™ï¸ Strategy Parameters")
        tf_opts  = ["1", "2", "5", "10", "15", "30", "60"]
        col1, col2 = st.columns(2)
        with col1:
            st.markdown("**ðŸŸ¢ BUY side**")
            drop_pct            = st.slider("Drop % for BUY trigger",  0.5, 10.0,
                float(cfg.get("drop_pct",            2.0)), step=0.25, key="s3_drop")
            avg_pct_buy         = st.slider("Avg % (BUY)",             0.5, 10.0,
                float(cfg.get("avg_pct_buy",         3.0)), step=0.25, key="s3_avg_buy")
            exit_offset_pct_buy = st.slider("Exit Offset % (BUY)",     0.5,  5.0,
                float(cfg.get("exit_offset_pct_buy", 1.0)), step=0.25, key="s3_exit_buy")
        with col2:
            st.markdown("**ðŸ”´ SELL side**")
            rise_pct             = st.slider("Rise % for SELL trigger", 0.5, 10.0,
                float(cfg.get("rise_pct",             2.0)), step=0.25, key="s3_rise")
            avg_pct_sell         = st.slider("Avg % (SELL)",            0.5, 10.0,
                float(cfg.get("avg_pct_sell",         3.0)), step=0.25, key="s3_avg_sell")
            exit_offset_pct_sell = st.slider("Exit Offset % (SELL)",    0.5,  5.0,
                float(cfg.get("exit_offset_pct_sell", 1.0)), step=0.25, key="s3_exit_sell")
        trigger_tf = st.selectbox("Trigger Timeframe (minutes)", tf_opts,
            index=tf_opts.index(str(cfg.get("trigger_timeframe","5"))),
            key="s3_tf")

        scanner_name = st.text_input("Scanner Name",
            value=scfg.get("name","Scanner 3 â€” Webhook Mirror"), key="s3_name")

        st.markdown("---")
        if st.button("ðŸ’¾ Save Settings", type="primary",
                     use_container_width=True, key="s3_save"):
            config["scanners"]["scanner_3"]["name"]     = scanner_name
            config["scanners"]["scanner_3"]["settings"] = {
                "drop_pct":            drop_pct,
                "rise_pct":            rise_pct,
                "avg_pct_buy":         avg_pct_buy,
                "avg_pct_sell":        avg_pct_sell,
                "exit_offset_pct_buy": exit_offset_pct_buy,
                "exit_offset_pct_sell":exit_offset_pct_sell,
                "trigger_timeframe":   trigger_tf,
            }
            config["scanners"]["scanner_3"]["outgoing_webhooks"] = {
                "buy_url":       buy_url,
                "sell_url":      sell_url,
                "exit_buy_url":  exit_buy_url,
                "exit_sell_url": exit_sell_url,
            }
            save_config(config)
            st.success("âœ… Saved! Restart scanner for trigger-timeframe changes to take effect.")

        st.markdown("---")
        st.code(
            f"BUY   : Chartink sends signal â†’ ref_price = live price\n"
            f"        First {trigger_tf}m candle closing {drop_pct:.2f}% below ref â†’ BUY fired\n"
            f"AVG   : Each {avg_pct_buy:.2f}% further drop from last avg â†’ Avg N fired\n"
            f"EXIT  : EXIT-BUY signal â†’ exit_ref = live price\n"
            f"        Candle closes {exit_offset_pct_buy:.2f}% above exit_ref â†’ EXIT-BUY fired\n"
            f"\n"
            f"SELL  : Chartink sends signal â†’ ref_price = live price\n"
            f"        First {trigger_tf}m candle closing {rise_pct:.2f}% above ref â†’ SELL fired\n"
            f"AVG   : Each {avg_pct_sell:.2f}% further rise from last avg â†’ Avg Short N fired\n"
            f"EXIT  : EXIT-SELL signal â†’ exit_ref = live price\n"
            f"        Candle closes {exit_offset_pct_sell:.2f}% below exit_ref â†’ EXIT-SELL fired",
            language="text"
        )


# â”€â”€â”€ Scanner 4 tab renderer (RSI Momentum) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
def _render_s4_tab(scanner_id: str, scfg: dict, config: dict, nav: str):
    """Renders the complete Scanner 4 (Multi-Timeframe RSI Momentum) tab."""

    state      = load_scanner_state(scanner_id)
    records    = state.get("records", {})
    signal_log = state.get("signal_log", [])

    buy_active  = {s: r for s, r in records.items()
                   if r.get("state", "").startswith("BUY") and r.get("state","").endswith("_ACTIVE")}
    sell_active = {s: r for s, r in records.items()
                   if r.get("state", "").startswith("SELL") and r.get("state","").endswith("_ACTIVE")}
    flagged     = {s: r for s, r in records.items()
                   if r.get("state") in ("FLAGGED_BUY", "FLAGGED_SELL")}
    cooling     = {s: r for s, r in records.items()
                   if r.get("state") in ("COOLING_BUY", "COOLING_SELL")}
    sl_cooling  = {s: r for s, r in records.items()
                   if r.get("state") in ("COOLING_BUY_STOPLOSS",
                                          "COOLING_SELL_STOPLOSS")}
    exits       = [e for e in reversed(signal_log)
                   if str(e.get("type","")).startswith("EXIT_")]

    m1, m2, m3, m4, m5, m6 = st.columns(6)
    m1.metric("ðŸŸ¢ Buy Active",     len(buy_active))
    m2.metric("ðŸ”´ Sell Active",    len(sell_active))
    m3.metric("ðŸš© Flagged",        len(flagged))
    m4.metric("â„ï¸ Cooling",        len(cooling))
    m5.metric("ðŸ›‘ Stoploss-cooling", len(sl_cooling))
    m6.metric("ðŸ“‹ Exits",          len(exits))
    st.markdown("---")

    cfg = scfg.get("settings", {})

    def _target_for(level: int, side: str) -> float:
        if side == "BUY":
            return float(cfg.get("buy1_target_pct", 5.0)) if level == 1 \
                   else float(cfg.get("buy23_target_pct", 6.0))
        return float(cfg.get("sell1_target_pct", 5.0)) if level == 1 \
               else float(cfg.get("sell23_target_pct", 6.0))

    def _state_label(s: str) -> str:
        return {
            "BUY1_ACTIVE":  "Buy 1",  "BUY2_ACTIVE":  "Buy 2",
            "BUY3_ACTIVE":  "Buy 3",  "BUY4_ACTIVE":  "Buy 4",
            "SELL1_ACTIVE": "Sell 1", "SELL2_ACTIVE": "Sell 2",
            "SELL3_ACTIVE": "Sell 3", "SELL4_ACTIVE": "Sell 4",
            "FLAGGED_BUY":  "Flagged (Buy)",
            "FLAGGED_SELL": "Flagged (Sell)",
            "COOLING_BUY":  "Cooling (Buy)",
            "COOLING_SELL": "Cooling (Sell)",
        }.get(s, s)

    # â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    # ACTIVE BUYS â€” shows BUY SIDE and SELL SIDE in separate sections
    # â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    if nav == "ðŸŸ¢ Active Buys":
        # â”€â”€ BUY SIDE â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        st.subheader(f"ðŸŸ¢ BUY SIDE â€” {len(buy_active)} active")
        if not buy_active:
            st.info("No active buy positions.")
        else:
            rows = []
            for sym, r in sorted(buy_active.items(),
                                 key=lambda x: x[1].get("entry_time") or "" or "",
                                 reverse=True):
                entry  = r.get("entry_price") or 0
                level  = r.get("entry_level") or 1
                cur    = live_price(sym, r.get("current_price") or entry)
                target = round(entry * (1.0 + _target_for(level, "BUY") / 100.0), 2) if entry else 0
                pnl    = round(((cur - entry) / entry * 100.0), 2) if entry else 0
                rows.append({
                    "Stock":        r.get("plain_name", sym),
                    "State":        _state_label(r.get("state","")),
                    "Entry Price":  f"â‚¹{entry:.2f}",
                    "Entry Time":   fmt_dt(r.get("entry_time")),
                    "Current":      f"â‚¹{cur:.2f}",
                    "Target":       f"â‚¹{target:.2f}",
                    "P&L":          colored_pnl(pnl),
                })
            st.dataframe(pd.DataFrame(rows), use_container_width=True, hide_index=True)

        st.markdown("---")

        # â”€â”€ SELL SIDE â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        st.subheader(f"ðŸ”´ SELL SIDE â€” {len(sell_active)} active")
        if not sell_active:
            st.info("No active sell positions.")
        else:
            rows = []
            for sym, r in sorted(sell_active.items(),
                                 key=lambda x: x[1].get("entry_time") or "" or "",
                                 reverse=True):
                entry  = r.get("entry_price") or 0
                level  = r.get("entry_level") or 1
                cur    = live_price(sym, r.get("current_price") or entry)
                target = round(entry * (1.0 - _target_for(level, "SELL") / 100.0), 2) if entry else 0
                pnl    = round(((entry - cur) / entry * 100.0), 2) if entry else 0
                rows.append({
                    "Stock":        r.get("plain_name", sym),
                    "State":        _state_label(r.get("state","")),
                    "Entry Price":  f"â‚¹{entry:.2f}",
                    "Entry Time":   fmt_dt(r.get("entry_time")),
                    "Current":      f"â‚¹{cur:.2f}",
                    "Target":       f"â‚¹{target:.2f}",
                    "P&L":          colored_pnl(pnl),
                })
            st.dataframe(pd.DataFrame(rows), use_container_width=True, hide_index=True)

        # â”€â”€ FLAGGED & COOLING quick view â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        if flagged or cooling or sl_cooling:
            st.markdown("---")
            c1, c2, c3 = st.columns(3)
            with c1:
                st.markdown(f"#### ðŸš© Flagged ({len(flagged)})")
                if flagged:
                    rows = [{
                        "Stock":   r.get("plain_name", s),
                        "State":   _state_label(r.get("state","")),
                        "RSI":     r.get("flagged_rsi") or "-",
                        "Since":   fmt_dt(r.get("flagged_at")),
                    } for s, r in flagged.items()]
                    st.dataframe(pd.DataFrame(rows),
                                 use_container_width=True, hide_index=True)
                else:
                    st.caption("None")
            with c2:
                st.markdown(f"#### â„ï¸ Cooling ({len(cooling)})")
                if cooling:
                    rows = [{
                        "Stock":  r.get("plain_name", s),
                        "State":  _state_label(r.get("state","")),
                        "Last":   r.get("entry_price") or "-",
                    } for s, r in cooling.items()]
                    st.dataframe(pd.DataFrame(rows),
                                 use_container_width=True, hide_index=True)
                else:
                    st.caption("None")
            with c3:
                # Stocks that hit the LIVE daily-RSI stoploss â€” stricter cooling gate
                st.markdown(f"#### ðŸ›‘ Stoploss-Cooling ({len(sl_cooling)})")
                if sl_cooling:
                    rows = [{
                        "Stock":      r.get("plain_name", s),
                        "Side":       "BUY" if r.get("state") == "COOLING_BUY_STOPLOSS" else "SELL",
                        "Entry â‚¹":    r.get("entry_price") or "-",
                        "Exit Time":  fmt_dt(r.get("entry_time")),
                    } for s, r in sl_cooling.items()]
                    st.dataframe(pd.DataFrame(rows),
                                 use_container_width=True, hide_index=True)
                    st.caption("Returns to GENERAL only when RSI recovers past the stricter "
                               "stoploss-cooling threshold.")
                else:
                    st.caption("None")

    # â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    # EXIT SIGNALS
    # â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    elif nav == "ðŸ”´ Exit Signals":
        st.subheader(f"ðŸ”´ Exit Signals â€” {len(exits)} total")
        if not exits:
            st.info("No exit signals yet.")
        else:
            rows = []
            for e in exits[:200]:
                entry_p = e.get("entry_price") or 0
                exit_p  = e.get("price") or 0
                pnl     = e.get("pnl_pct", 0) or 0
                side    = "BUY" if "BUY" in e.get("type","") else "SELL"
                rows.append({
                    "Stock":      e.get("stock") or e.get("plain_name",""),
                    "Side":       side,
                    "Label":      e.get("label",""),
                    "Entry â‚¹":    f"â‚¹{entry_p:.2f}" if entry_p else "-",
                    "Exit â‚¹":     f"â‚¹{exit_p:.2f}",
                    "Exit Time":  fmt_dt(e.get("time")),
                    "Level":      e.get("entry_level","-"),
                    "P&L":        colored_pnl(float(pnl) if pnl else 0),
                })
            st.dataframe(pd.DataFrame(rows), use_container_width=True, hide_index=True)

    # â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    # WATCHED â€” Strategy 4 shows FLAGGED here
    # â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    elif nav == "ðŸ‘ï¸ Watched Stocks":
        st.subheader(f"ðŸš© Flagged â€” {len(flagged)} stocks waiting for cooldown")
        if not flagged:
            st.info("No flagged stocks.")
        else:
            rows = []
            for sym, r in sorted(flagged.items(),
                                 key=lambda x: x[1].get("flagged_at") or "" or "",
                                 reverse=True):
                cur = live_price(sym, r.get("current_price") or 0)
                rows.append({
                    "Stock":   r.get("plain_name", sym),
                    "Side":    "BUY" if r.get("state") == "FLAGGED_BUY" else "SELL",
                    "Flag RSI": r.get("flagged_rsi") or "-",
                    "Since":   fmt_dt(r.get("flagged_at")),
                    "Now â‚¹":   f"â‚¹{cur:.2f}",
                })
            st.dataframe(pd.DataFrame(rows), use_container_width=True, hide_index=True)

    # â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    # SIGNAL LOG
    # â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    elif nav == "ðŸ“‹ Signal Log":
        st.subheader("ðŸ“‹ Signal Log â€” Scanner 4")
        if not signal_log:
            st.info("No signals yet.")
        else:
            rows = []
            for e in reversed(signal_log):
                t  = str(e.get("type",""))
                px = e.get("price") or 0
                info_parts = []
                if e.get("target_price"):
                    info_parts.append(f"Target:â‚¹{e['target_price']:.2f}")
                if e.get("daily_rsi") is not None:
                    info_parts.append(f"D-RSI:{e['daily_rsi']}")
                if e.get("pnl_pct") is not None and "EXIT" in t:
                    info_parts.append(f"P&L:{e['pnl_pct']:+.2f}%")
                rows.append({
                    "Type":  e.get("label", t),
                    "Stock": e.get("stock") or e.get("plain_name",""),
                    "Price": f"â‚¹{float(px):.2f}" if px else "-",
                    "Time":  fmt_dt(e.get("time")),
                    "Info":  " | ".join(info_parts),
                })
            st.dataframe(pd.DataFrame(rows), use_container_width=True, hide_index=True)

    # â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    # SETTINGS
    # â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    elif nav == "âš™ï¸ Settings":
        st.subheader(f"âš™ï¸ Settings â€” {scfg.get('name', scanner_id)}")

        # â”€â”€ Stock-group selectors â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        st.markdown("### ðŸ“š STOCK GROUPS")
        try:
            from core.stock_groups import get_stock_groups
            _sg     = get_stock_groups()
            _sg.reload()  # pick up any new CSVs the user dropped in
            _groups = _sg.list()
            _counts = {g: _sg.size(g) for g in _groups}
        except Exception as _e:
