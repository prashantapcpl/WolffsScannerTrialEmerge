            sell3_rise_pct      = st.slider("Sell 3/4 rise %",         0.0, 10.0,
                float(cfg.get("sell3_rise_pct", 3.0)), step=0.25, key="s4_s3r")
        with scol2:
            daily_rsi_sell_filter  = st.slider("Daily RSI filter (<)",  15.0, 60.0,
